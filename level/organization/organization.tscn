[node name="clue_level3" parent="items_control" unique_id=1638936245 instance=ExtResource("9_dep2x")]
position = Vector2(184, 224)
content = "[font_size=24][left]他离开了
我才有机会写下这些。
我不清楚我做过什么，
也不清楚怎么会在这。
总之我想离开这里[/left][/font_size]"
duration = 8.0
id = 3
tooltip_offset = Vector2(0, -42)
fakable = false

[node name="clue_level5" parent="items_control" unique_id=1948172210 instance=ExtResource("9_dep2x")]
position = Vector2(24, 224)
content = "[font_size=42]实验记录[font_size=24]
[left]批次: 第157次
实验人员离开后，
克隆体进行了书写行为。
后续检查中，
却并未发现任何书写物。[/left][/font_size]"
id = 5
tooltip_offset = Vector2(0, -42)
fakable = false

[node name="clue_level8" parent="items_control" unique_id=2130965820 instance=ExtResource("9_dep2x")]
position = Vector2(312, 224)
content = "[font_size=24][left]我很痛苦，却无法离开
我毁了他们的档案室
里面有好多和我相似的家伙
马上他们就要来抓我了
我也许要死了
在这之前我想写下这些
他们发现不了
但愿没有下一个“我”遭罪
[/left][/font_size]"
duration = 15.0
id = 8
tooltip_offset = Vector2(0, -42)
fakable = false

